#!/bin/sh
# A single steady LED represents the successful startup of either Wi-Fi radio.

led="$1"
[ -d "$led" ] || exit 1
max_brightness=$(cat "$led/max_brightness") || exit 1

turn_off() {
	printf '0\n' > "$led/brightness"
}

trap 'exit 0' INT TERM
trap turn_off EXIT

while :; do
	brightness=0
	if status=$(ubus -t 1 call network.wireless status 2>/dev/null); then
		for up in $(jsonfilter -s "$status" -e '@[@.up=true].up' 2>/dev/null); do
			[ "$up" = "true" ] && brightness=$max_brightness
		done
	fi

	case "$(cat "$led/trigger")" in
		none|*'[none]'*) ;;
		*) printf 'none\n' > "$led/trigger" ;;
	esac
	[ "$(cat "$led/brightness")" = "$brightness" ] || \
		printf '%s\n' "$brightness" > "$led/brightness"
	sleep 1
done
